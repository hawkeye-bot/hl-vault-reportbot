# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID to send notifications to (your personal chat or a group)
TELEGRAM_CHAT_ID=your_chat_id_here

# Hyperliquid vault address to monitor (the vault's on-chain address)
VAULT_ADDRESS=0xyour_vault_address_here

# Your own Hyperliquid wallet address (to look up your depositor equity)
USER_ADDRESS=0xyour_wallet_address_here

# Poll interval in seconds (how often to check for new vault activity)
POLL_INTERVAL_SECONDS=30

# Margin ratio below which a liquidation warning is sent (0.0–1.0)
LIQUIDATION_WARN_THRESHOLD=0.1

# Hour of day (UTC) to send the daily PnL summary (0-23)
DAILY_SUMMARY_HOUR=8

# Send a position status message if nothing else has been posted for this many seconds
HEARTBEAT_INTERVAL_SECONDS=7200
